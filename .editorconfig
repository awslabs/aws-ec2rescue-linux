# EditorConfig: https://editorconfig.org

# top-most EditorConfig file
root = true

# Global rules for all files
[*]
charset = utf-8
end_of_line = lf
spelling_language = en-US
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100
docstring_fill_column = 99

[.venvs/**.py]
indent_size = unset
indent_style = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
end_of_line = unset

[*.{sh,bash}]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = true
space_redirects = true
shell_variant = bash

[*.{cmd,bat,ps1,psm1,psd1}]
end_of_line = crlf

[Makefile]
indent_style = tab
indent_size = 4

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yaml,yml,yamllint}]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.{cfg,ini,conf}]
indent_style = space
indent_size = 4

[*.{html,htm,css}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[NOTICE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.txt]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
